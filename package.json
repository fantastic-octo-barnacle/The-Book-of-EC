{
  "type": "module",
  "imports": {
    "#content/*": "./src/.vitepress/content/*",
    "#nodes/*": "./src/nodes/*"
  },
  "scripts": {
    "dev": "vitepress dev src",
    "fmt": "oxfmt .",
    "fmt:check": "oxfmt --check .",
    "lint": "oxlint src/.vitepress --deny-warnings",
    "lint:fix": "oxlint src/.vitepress --fix",
    "typecheck": "vue-tsc --noEmit",
    "check": "pnpm run fmt:check && pnpm run lint && pnpm run typecheck",
    "build": "vitepress build src",
    "preview": "vitepress preview src"
  },
  "dependencies": {
    "cytoscape": "^3.34.0",
    "cytoscape-dagre": "^4.0.0"
  },
  "devDependencies": {
    "@types/cytoscape-dagre": "^2.3.4",
    "@types/node": "^24.13.3",
    "oxfmt": "0.62.0",
    "oxlint": "1.77.0",
    "playwright": "1.55.0",
    "typescript": "^5.9.3",
    "vite": "8.2.1",
    "vitepress": "2.0.0-alpha.19",
    "vue": "3.5.41",
    "vue-tsc": "^3.3.9"
  },
  "packageManager": "pnpm@11.21.0"
}
