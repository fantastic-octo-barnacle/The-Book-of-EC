{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 100,
  "tabWidth": 2,
  "useTabs": false,
  "semi": false,
  "singleQuote": false,
  "trailingComma": "none",
  "endOfLine": "lf",
  "proseWrap": "preserve",
  "ignorePatterns": ["node_modules/**", "src/.vitepress/cache/**", "src/.vitepress/dist/**"]
}
